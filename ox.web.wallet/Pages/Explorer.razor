@page "/_pc/blockchain/explorer"
@page "/_pc/blockchain/explorer/{blockindex}"
@layout BlockchainLayout
@inherits BlockchainComponentBase
<Microsoft.AspNetCore.Components.Web.Extensions.Head.Title Value=@PageTitle />
<PageContainer Title=@PageTitle>
    <ChildContent>
        <Flex Gap="middle">

            <Flex Vertical=this.IsMobile>
                <div class="row">
                    <Button Type="@ButtonType.Primary" OnClick="Previous">@this.WebLocalString("< 上一个", "< Previous")</Button>
                </div>
                <div class="row">
                    <Search Placeholder="@this.WebLocalString("输入区块高度","input block index")" EnterButton="@this.WebLocalString("查看区块","View Block")" @bind-Value="@this.blockindex" OnSearch="OnSearch" />
                </div>
                <div class="row">
                    <Button Type="@ButtonType.Primary" OnClick="Next">@this.WebLocalString("下一个 >", "Next >")</Button>
                </div>
            </Flex>
        </Flex>

        <Flex Gap="middle">
            @if (this.block.IsNotNull())
            {
                <Flex Vertical=this.IsMobile>
                    <ul>
                        <li>
                            @this.WebLocalString("区块时间", "Block Time"): <Text Code>@this.block.Timestamp.ToDateTime().ToLongTimeString()</Text>
                        </li>
                        <li>
                            @this.WebLocalString("区块随机数", "Block Nonce"): <Text Code>@this.block.ConsensusData</Text>
                        </li>

                    </ul>

                    <Collapse>
                        @{
                            int i = 0;
                            foreach (var tx in this.block.Transactions)
                            {
                                if (tx.Type != Network.P2P.Payloads.TransactionType.MinerTransaction)
                                {
                                    var s = $"{tx.Type.ToString()} / {this.OmitString(tx.Hash.ToString())}";
                                    <Panel Header="@s" Key="@i.ToString()">
                                        <Collapse>
                                            <Panel Header='@this.WebLocalString("输入","Input")'>

                                                @foreach (var refer in tx.References)
                                                {
                                                    <ul>
                                                        <li>
                                                            @this.WebLocalString($"地址:{this.OmitString(refer.Value.ScriptHash.ToAddress())}", $"Address:{this.OmitString(refer.Value.ScriptHash.ToAddress())}")
                                                        </li>
                                                        <li>
                                                            @this.WebLocalString($"资产Id:{this.OmitString(refer.Value.AssetId.ToString())}", $"Asset Id:{this.OmitString(refer.Value.AssetId.ToString())}")
                                                        </li>
                                                        <li>
                                                            @this.WebLocalString($"金额:{refer.Value.Value}", $"Amount:{refer.Value.Value}")
                                                        </li>
                                                    </ul>
                                                    <Divider />
                                                }

                                            </Panel>
                                            <Panel Header='@this.WebLocalString("输出","Output")'>

                                                @foreach (var output in tx.Outputs)
                                                {
                                                    <ul>
                                                        <li>
                                                            @this.WebLocalString($"地址:{this.OmitString(output.ScriptHash.ToAddress())}", $"Address:{this.OmitString(output.ScriptHash.ToAddress())}")
                                                        </li>
                                                        <li>
                                                            @this.WebLocalString($"资产Id:{this.OmitString(output.AssetId.ToString())}", $"Asset Id:{this.OmitString(output.AssetId.ToString())}")
                                                        </li>
                                                        <li>
                                                            @this.WebLocalString($"金额:{output.Value}", $"Amount:{output.Value}")
                                                        </li>
                                                    </ul>
                                                    <Divider />
                                                }
                                            </Panel>
                                        </Collapse>
                                    </Panel>
                                    i++;
                                }
                            }
                        }
                    </Collapse>
                </Flex>
            }
        </Flex>
    </ChildContent>
</PageContainer>
<style>
    .col {
        text-align: center;
    }

    .row {
        margin-bottom: 20px;
    }
</style>